# --- Claude (required) ---
# Create a key at https://platform.claude.com. Web search and web fetch must be
# enabled for your organization in the Claude Console.
ANTHROPIC_API_KEY=

# --- Database (required) ---
# Any Postgres works. Neon or Supabase are easy on Vercel.
DATABASE_URL=postgres://user:password@host:5432/lex

# --- Auth.js (required) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Google sign-in (optional, enable at least one provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via Resend (optional)
AUTH_RESEND_KEY=
EMAIL_FROM="LEX <no-reply@your-domain.com>"

# --- Encryption at rest (required) ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Limits (optional) ---
DAILY_QUESTION_LIMIT=20
